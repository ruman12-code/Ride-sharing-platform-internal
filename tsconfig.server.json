{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist-server",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "rootDir": "."
  },
  "include": [
    "server",
    "src/domain",
    "src/ports",
    "src/adapters/local-json/seed"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/test"
  ]
}
