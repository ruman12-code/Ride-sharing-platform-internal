# Copy to .env.local and fill in. Never commit the filled-in file.
#
#   cp .env.example .env.local
#   npm run preflight -- your.own@email.com

# --- who approves colleagues ------------------------------------------------
# Your own personal address. Registering with it is approved immediately and as
# an admin, so you join by the same door as everybody else.
ADMIN_EMAIL=ruman12@gmail.com

# --- where the app lives ----------------------------------------------------
# What sign-in links point at. It MUST be the address colleagues actually open.
# With Tailscale Funnel this is your machine and tailnet name; `tailscale status`
# prints it. Must be https, or push notifications will not work at all.
APP_URL=https://your-machine.your-tailnet.ts.net

# Something else terminates TLS in front of this process (Tailscale, Caddy).
TRUST_PROXY=1
# ...and it reaches us over loopback, so do not also listen on the office LAN.
BIND_HOST=127.0.0.1
PORT=8080

# The database file. Anywhere that is backed up and survives a reboot.
DB_PATH=./carpool.db

# --- email: nobody can sign in without this ---------------------------------
# See docs/EMAIL_SETUP.md. A dedicated Gmail account, not your personal one.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ekpothe.dhaka@gmail.com
SMTP_PASS=
SMTP_FROM=Ekpothe <ekpothe.dhaka@gmail.com>

# --- push notifications -----------------------------------------------------
# Generate once with `npm run setup`. Do NOT regenerate after colleagues have
# subscribed: every existing subscription is tied to the old key and goes silent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ruman12@gmail.com

# --- joining ----------------------------------------------------------------
# Work addresses that registration refuses, so no employer address is stored.
BLOCKED_EMAIL_DOMAINS=giz.de
