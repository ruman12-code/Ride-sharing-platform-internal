# Copy to .env.local and fill in. Never commit the filled-in file.
#
#   cp .env.example .env.local
#   npm run preflight -- your.own@email.com

# --- who approves colleagues ------------------------------------------------
# Your own personal address. Registering with it is approved immediately and as
# an admin, so you join by the same door as everybody else.
ADMIN_EMAIL=ruman12@gmail.com

# --- where the app lives ----------------------------------------------------
# What sign-in links point at. It MUST be the address colleagues actually open,
# and it must be https or push notifications will not work at all.
APP_URL=https://ekpothe.onrender.com

# Something else terminates TLS in front of this process.
TRUST_PROXY=1
PORT=8080

# Only when that proxy runs on this same machine (Caddy, Tailscale Funnel).
# On a hosting platform leave it unset: there the proxy is across a network.
# BIND_HOST=127.0.0.1

# Postgres. Free and no card at neon.tech; Supabase works too.
# Not Render's own free Postgres — it expires 30 days after creation.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- the administrator's first way in ---------------------------------------
# Colleagues join by a code you mint for them. You have nobody to mint one for
# you, so set any secret string here, sign in once with it, then delete it.
ADMIN_BOOTSTRAP_CODE=

# --- email: optional ---------------------------------------------------------
# The app works without it: colleagues join by code and notifications go by
# push. Email adds a sign-in link, and reaches anyone who never granted push
# permission. See docs/EMAIL_SETUP.md.
#
# Over HTTPS, via Brevo. Needed on any host that blocks outbound SMTP — which
# includes Render's free tier, by policy, on ports 25, 465 and 587.
BREVO_API_KEY=
SMTP_FROM=Ekpothe <you@example.com>

# Over SMTP instead, for a host that permits it. Ignored when BREVO_API_KEY is
# set, because a host that needs the HTTP path cannot use this one at all.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- push notifications -----------------------------------------------------
# Generate once with `npm run setup`. Do NOT regenerate after colleagues have
# subscribed: every existing subscription is tied to the old key and goes silent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ruman12@gmail.com

# --- joining ----------------------------------------------------------------
# Work addresses that registration refuses, so no employer address is stored.
BLOCKED_EMAIL_DOMAINS=giz.de
